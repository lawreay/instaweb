APP_NAME=Instaweb
APP_ENV=production
APP_DEBUG=false

# Portfolio AI: provider keys stay server-side. A visitor-entered key is used
# for one request only and is never stored.
PORTFOLIO_AI_ENABLED=1
PORTFOLIO_AI_DEFAULT_PROVIDER=openrouter
PORTFOLIO_AI_ALLOW_REQUEST_KEY=1
PORTFOLIO_AI_OPENROUTER_DAILY_LIMIT=40
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=https://example.com
APP_TIMEZONE=Africa/Blantyre
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
WORDPRESS_PACKAGE_PATH=storage/wordpress/wordpress-6.9.3.zip
WORDPRESS_PACKAGE_SHA256=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Instaweb
